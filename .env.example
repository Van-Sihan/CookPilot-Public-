# CookPilot 환경 변수 견본
#
# 이 파일을 `.env.local` 로 복사하고 값을 채운다. 값은 절대 커밋하지 않는다.
# 배포할 때는 같은 이름으로 버셀 Project Settings → Environment Variables 에 넣는다.

# ── 필수 ────────────────────────────────────────────────
# Supabase 프로젝트 주소. 대시보드 → Project Settings → Data API
NEXT_PUBLIC_SUPABASE_URL=

# Supabase 공개 키. 예전 이름은 anon key 다.
# 코드가 `PUBLISHABLE_KEY ?? ANON_KEY` 로 받으므로 둘 중 하나만 넣으면 된다
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── AI 요리 상담(FN11) 에 필요 ──────────────────────────
# 없으면 /ask 가 'key' 오류를 낸다. 서버에서만 쓰이며 브라우저로 나가지 않는다
PINECONE_API_KEY=
PINECONE_HOST=

# ── 선택 ────────────────────────────────────────────────
# 배포 도메인. 링크 미리보기(og:image)의 뿌리 주소로 쓴다.
# 비워 두면 버셀이 넣어 주는 운영 도메인을 쓰고, 그것도 없으면 localhost:3000
NEXT_PUBLIC_SITE_URL=

# 파인콘 인덱스 이름. 비워 두면 PINECONE_HOST 에서 유도한다
PINECONE_INDEX=

# 서버용 Gemini 키. 비워 두면 브라우저가 보낸 키를 쓴다.
# 요리 기능(FN03~FN06)은 브라우저에 저장한 키만 쓰므로 여기 없어도 된다
GOOGLE_API_KEY=
