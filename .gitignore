# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# 값이 빠진 견본은 올린다. 배포할 때 어떤 변수가 필요한지 알려 주는 파일이다
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 문서 생성 스크립트 캐시
__pycache__/
*.pyc
