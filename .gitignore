# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# 값이 빠진 견본은 올린다. 배포할 때 어떤 변수가 필요한지 알려 주는 파일이다
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 문서 생성 스크립트 캐시
__pycache__/
*.pyc

# 오피스 잠금 파일 (xlsx 를 열어 둔 동안 생긴다)
~$*

# 개발 전용 파일 — 제출 브랜치에서만 무시한다.
# 깃은 이미 추적 중인 파일에는 무시 규칙을 적용하지 않으므로 main 에서는 아무 일도
# 일어나지 않는다. 제출 브랜치에서 추적만 끊었을 때, next dev 가 AGENTS.md 를 다시
# 만들어도 작업 트리가 더러워지지 않게 하려고 적어 둔다
/AGENTS.md
/CLAUDE.md
/.claude/
/docs/learn/
/docs/prompts/
